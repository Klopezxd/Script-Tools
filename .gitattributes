# Standard Git line-ending normalization across platforms
* text=auto

# Code and documentation (LF)
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Windows-native shell and registry files (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.reg text eol=crlf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.mp4 binary
*.mkv binary
